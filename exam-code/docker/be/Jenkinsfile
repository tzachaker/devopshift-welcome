pipeline {
    agent any

    environment {
        DOCKER_CREDENTIALS = credentials('dockerhub_credentials')
    }

    stages {
        stage('Checkout SCM') {
            steps {
                script {
                    // Checkout from Git repository
                    checkout scm
                }
            }
        }
        
        stage('Lint & Security Scan') {
            steps {
                script {
                    // Run lint and security scan with flake8 and bandit
                    sh 'pip install flake8 bandit'
                    sh 'flake8 .'
                }
            }
        }

        stage('Install Dependencies') {
            when {
                expression {
                    return currentBuild.result == null || currentBuild.result == 'SUCCESS'
                }
            }
            steps {
                script {
                    // Install dependencies in virtual environment or Docker container
                    sh 'pip install -r requirements.txt'
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression {
                    return currentBuild.result == null || currentBuild.result == 'SUCCESS'
                }
            }
            steps {
                script {
                    // Build Docker image
                    sh 'docker build -t my_image .'
                }
            }
        }

        stage('Run Tests in Container') {
            when {
                expression {
                    return currentBuild.result == null || currentBuild.result == 'SUCCESS'
                }
            }
            steps {
                script {
                    // Run tests in Docker container
                    sh 'docker run my_image pytest tests/'
                }
            }
        }

        stage('Push to Docker Hub') {
            when {
                expression {
                    return currentBuild.result == null || currentBuild.result == 'SUCCESS'
                }
            }
            steps {
                script {
                    // Push Docker image to Docker Hub
                    sh 'docker push my_image'
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    // Cleanup Docker images and containers
                    sh 'docker system prune -f'
                }
            }
        }
    }
}
